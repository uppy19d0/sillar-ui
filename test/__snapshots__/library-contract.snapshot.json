{
  "markup": "<main data-theme=\"dark\" aria-label=\"Sillar UI component contract\">\n<section aria-label=\"Actions and status\">\n<button data-slot=\"button\" class=\"slr-button slr-button--default slr-button--md\" type=\"button\">Save changes</button>\n<button data-slot=\"button\" class=\"slr-button slr-button--secondary slr-button--sm\" type=\"button\">Preview</button>\n<button data-slot=\"button\" class=\"slr-button slr-button--outline slr-button--md\" type=\"button\">Cancel</button>\n<button data-slot=\"button\" data-loading=\"true\" class=\"slr-button slr-button--destructive slr-button--md\" type=\"button\" disabled=\"\" aria-busy=\"true\">\n<span data-slot=\"loading-indicator\" data-size=\"sm\" class=\"slr-loading-indicator\" aria-hidden=\"true\">\n<span class=\"slr-spinner\" aria-hidden=\"true\">\n</span>\n</span>Delete</button>\n<span data-slot=\"badge\" class=\"slr-badge slr-badge--default\">Default</span>\n<span data-slot=\"badge\" class=\"slr-badge slr-badge--success\">Production ready</span>\n<span data-slot=\"badge\" class=\"slr-badge slr-badge--destructive\">Action required</span>\n</section>\n<div data-slot=\"card\" class=\"slr-card slr-card--elevated\">\n<div data-slot=\"card-header\" class=\"slr-card__header\">\n<h3 data-slot=\"card-title\" class=\"slr-card__title\">Account settings</h3>\n<p data-slot=\"card-description\" class=\"slr-card__description\">A stable composed card contract.</p>\n</div>\n<div data-slot=\"card-content\" class=\"slr-card__content\">\n<div data-slot=\"field\" data-invalid=\"true\" class=\"slr-field-group\">\n<label data-slot=\"field-label\" class=\"slr-field-label\" for=\"email\">Email<span class=\"slr-field-required\" aria-hidden=\"true\">*</span>\n</label>\n<input data-slot=\"input\" class=\"slr-field slr-input\" id=\"email\" aria-invalid=\"true\" value=\"person@example.com\"/>\n<p data-slot=\"field-description\" class=\"slr-field-description\">Used for product updates.</p>\n<p data-slot=\"field-error\" role=\"alert\" class=\"slr-field-error\">Confirm this address.</p>\n</div>\n<span class=\"slr-select-wrap\">\n<select data-slot=\"select\" class=\"slr-field slr-select\" aria-label=\"Role\">\n<option value=\"designer\" selected=\"\">Designer</option>\n<option value=\"engineer\">Engineer</option>\n</select>\n<span class=\"slr-select-chevron\" aria-hidden=\"true\">\n</span>\n</span>\n<textarea data-slot=\"textarea\" class=\"slr-field slr-textarea\" aria-label=\"Notes\">Snapshot coverage</textarea>\n<div data-slot=\"text-field\" data-variant=\"glass\" data-tone=\"neutral\" data-size=\"md\" class=\"slr-text-field\">\n<label for=\"sillar-text-field\" data-slot=\"text-field-label\" class=\"slr-text-field__label\">Workspace</label>\n<div class=\"slr-text-field__control\">\n<span class=\"slr-text-field__adornment\" data-position=\"leading\" aria-hidden=\"true\">@</span>\n<input id=\"sillar-text-field\" data-slot=\"text-field-input\" class=\"slr-text-field__input\" aria-describedby=\"sillar-text-field-description\" maxLength=\"24\" value=\"sillar\"/>\n<span class=\"slr-text-field__adornment\" data-position=\"trailing\" aria-hidden=\"true\">.app</span>\n</div>\n<div class=\"slr-text-field__meta\">\n<div class=\"slr-text-field__messages\">\n<p id=\"sillar-text-field-description\" class=\"slr-text-field__description\">A premium input pattern for product forms.</p>\n</div>\n<p class=\"slr-text-field__counter\" aria-label=\"6 of 24 characters\">6/24</p>\n</div>\n</div>\n</div>\n<div data-slot=\"card-footer\" class=\"slr-card__footer\">\n<button aria-label=\"Email notifications\" type=\"button\" role=\"switch\" aria-checked=\"true\" data-slot=\"switch\" data-state=\"checked\" class=\"slr-switch\">\n<span class=\"slr-switch__thumb\" data-state=\"checked\">\n</span>\n</button>\n</div>\n</div>\n<div data-slot=\"separator\" data-orientation=\"horizontal\" role=\"none\" class=\"slr-separator\">\n</div>\n<div data-slot=\"callout\" class=\"slr-callout slr-callout--warning\">\n<h3 data-slot=\"callout-title\" class=\"slr-callout__title\">Review changes</h3>\n<div data-slot=\"callout-description\" class=\"slr-callout__description\">Theme and markup changes are snapshot tested.</div>\n</div>\n<section data-slot=\"calculator-shell\" data-width=\"default\" class=\"slr-calculator-shell\">\n<div class=\"slr-calculator-shell__header\">\n<div class=\"slr-calculator-shell__intro\">\n<p class=\"slr-calculator-shell__eyebrow\">Pricing</p>\n<div class=\"slr-calculator-shell__title-row\">\n<h2 class=\"slr-calculator-shell__title\">Plan estimator</h2>\n<span data-slot=\"badge\" class=\"slr-badge slr-badge--secondary\">Product pattern</span>\n</div>\n</div>\n</div>\n<div class=\"slr-calculator-shell__layout\" data-has-aside=\"true\">\n<div class=\"slr-calculator-shell__main\">\n<div data-slot=\"calculator-panel\" class=\"slr-calculator-panel\">\n<div class=\"slr-calculator-panel__header\">\n<div class=\"slr-calculator-panel__intro\">\n<h3 class=\"slr-calculator-panel__title\">Configuration inputs</h3>\n<p class=\"slr-calculator-panel__description\">Reusable layout for SaaS, commerce, and operations workflows.</p>\n</div>\n</div>\n<div class=\"slr-calculator-panel__content\">\n<div data-slot=\"form-grid\" data-columns=\"2\" class=\"slr-form-grid\" style=\"--slr-form-grid-columns:2;--slr-form-grid-min:16rem\">\n<span data-slot=\"money-input\" class=\"slr-number-input\">\n<input type=\"text\" data-slot=\"input\" class=\"slr-field slr-input slr-number-input__control\" aria-label=\"Monthly budget\" inputMode=\"decimal\" value=\"$85,000.00\"/>\n<span class=\"slr-number-input__adornment\" aria-hidden=\"true\">USD</span>\n</span>\n<span data-slot=\"percentage-input\" class=\"slr-number-input\">\n<input type=\"text\" data-slot=\"input\" class=\"slr-field slr-input slr-number-input__control\" aria-label=\"Growth percentage\" inputMode=\"decimal\" value=\"12\"/>\n<span class=\"slr-number-input__adornment\" aria-hidden=\"true\">%</span>\n</span>\n</div>\n</div>\n</div>\n</div>\n<aside class=\"slr-calculator-shell__aside\">\n<section data-slot=\"result-summary\" data-tone=\"brand\" class=\"slr-result-summary\">\n<div class=\"slr-result-summary__header\">\n<div class=\"slr-result-summary__intro\">\n<div class=\"slr-result-summary__title-row\">\n<h3 class=\"slr-result-summary__title\">Estimated monthly total</h3>\n</div>\n<p class=\"slr-result-summary__value\">$349</p>\n<p class=\"slr-result-summary__description\">Projected total based on the selected configuration.</p>\n</div>\n</div>\n<dl data-slot=\"breakdown-list\" class=\"slr-breakdown-list\">\n<div class=\"slr-breakdown-list__item\" data-tone=\"neutral\">\n<dt class=\"slr-breakdown-list__label\">Base plan</dt>\n<dd class=\"slr-breakdown-list__value\">$249</dd>\n</div>\n<div class=\"slr-breakdown-list__item\" data-tone=\"warning\">\n<dt class=\"slr-breakdown-list__label\">Usage buffer</dt>\n<dd class=\"slr-breakdown-list__value\">$100</dd>\n</div>\n</dl>\n</section>\n</aside>\n</div>\n</section>\n<dl data-slot=\"breakdown-list\" class=\"slr-breakdown-list\">\n<div class=\"slr-breakdown-list__item\" data-tone=\"neutral\">\n<dt class=\"slr-breakdown-list__label\">Estimated total<span>Base plan plus usage buffer</span>\n</dt>\n<dd class=\"slr-breakdown-list__value\">$349</dd>\n</div>\n</dl>\n<div data-slot=\"tabs\" data-orientation=\"horizontal\" class=\"slr-tabs\">\n<div aria-label=\"Component view\" role=\"tablist\" aria-orientation=\"horizontal\" data-slot=\"tabs-list\" data-orientation=\"horizontal\" class=\"slr-tabs__list\">\n<button id=\"sillar-tabs-tab-preview\" type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"sillar-tabs-panel-preview\" tabindex=\"0\" data-slot=\"tabs-trigger\" data-state=\"active\" data-orientation=\"horizontal\" class=\"slr-tabs__trigger\">Preview</button>\n<button id=\"sillar-tabs-tab-code\" type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"sillar-tabs-panel-code\" tabindex=\"-1\" data-slot=\"tabs-trigger\" data-state=\"inactive\" data-orientation=\"horizontal\" class=\"slr-tabs__trigger\">Code</button>\n</div>\n<div id=\"sillar-tabs-panel-preview\" role=\"tabpanel\" aria-labelledby=\"sillar-tabs-tab-preview\" tabindex=\"0\" data-slot=\"tabs-content\" data-state=\"active\" data-orientation=\"horizontal\" class=\"slr-tabs__content\">Rendered component</div>\n<div id=\"sillar-tabs-panel-code\" role=\"tabpanel\" aria-labelledby=\"sillar-tabs-tab-code\" tabindex=\"0\" hidden=\"\" data-slot=\"tabs-content\" data-state=\"inactive\" data-orientation=\"horizontal\" class=\"slr-tabs__content\">Component source</div>\n</div>\n<section aria-label=\"Navigation and data\">\n<nav aria-label=\"Breadcrumb\" data-slot=\"breadcrumb\" class=\"slr-breadcrumb\">\n<ol data-slot=\"breadcrumb-list\" class=\"slr-breadcrumb__list\">\n<li data-slot=\"breadcrumb-item\" class=\"slr-breadcrumb__item\">\n<a href=\"/\" data-slot=\"breadcrumb-link\" class=\"slr-breadcrumb__link\">Home</a>\n</li>\n<li role=\"presentation\" aria-hidden=\"true\" data-slot=\"breadcrumb-separator\" class=\"slr-breadcrumb__separator\">\n<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" focusable=\"false\">\n<path d=\"m9 18 6-6-6-6\">\n</path>\n</svg>\n</li>\n<li data-slot=\"breadcrumb-item\" class=\"slr-breadcrumb__item\">\n<span aria-current=\"page\" data-slot=\"breadcrumb-page\" class=\"slr-breadcrumb__page\">Reports</span>\n</li>\n</ol>\n</nav>\n<div data-slot=\"table-container\" class=\"slr-table__container\" role=\"region\" tabindex=\"0\" aria-label=\"Monthly totals\">\n<table data-slot=\"table\" data-density=\"comfortable\" data-striped=\"\" class=\"slr-table\">\n<caption data-slot=\"table-caption\" class=\"slr-table__caption\">Totals by month</caption>\n<thead data-slot=\"table-header\" class=\"slr-table__header\">\n<tr data-slot=\"table-row\" class=\"slr-table__row\">\n<th scope=\"col\" aria-sort=\"ascending\" data-slot=\"table-head\" data-align=\"start\" class=\"slr-table__head\">Month</th>\n<th scope=\"col\" data-slot=\"table-head\" data-align=\"end\" class=\"slr-table__head\">Amount</th>\n</tr>\n</thead>\n<tbody data-slot=\"table-body\" class=\"slr-table__body\">\n<tr data-slot=\"table-row\" data-state=\"selected\" aria-selected=\"true\" class=\"slr-table__row\">\n<td data-slot=\"table-cell\" data-align=\"start\" class=\"slr-table__cell\">January</td>\n<td data-slot=\"table-cell\" data-align=\"end\" data-numeric=\"\" class=\"slr-table__cell\">45,000</td>\n</tr>\n</tbody>\n</table>\n</div>\n<nav aria-label=\"Pagination\" data-slot=\"pagination\" class=\"slr-pagination\">\n<ul class=\"slr-pagination__list\">\n<li>\n<button type=\"button\" aria-label=\"Previous\" class=\"slr-pagination__link\">\n<span aria-hidden=\"true\">‹</span>\n<span class=\"slr-pagination__label\">Previous</span>\n</button>\n</li>\n<li>\n<button type=\"button\" aria-label=\"Page 1\" class=\"slr-pagination__link\">1</button>\n</li>\n<li class=\"slr-pagination__ellipsis\" aria-hidden=\"true\">…</li>\n<li>\n<button type=\"button\" aria-label=\"Page 4\" class=\"slr-pagination__link\">4</button>\n</li>\n<li>\n<button type=\"button\" aria-label=\"Page 5\" aria-current=\"page\" class=\"slr-pagination__link slr-pagination__link--active\" data-active=\"\">5</button>\n</li>\n<li>\n<button type=\"button\" aria-label=\"Page 6\" class=\"slr-pagination__link\">6</button>\n</li>\n<li class=\"slr-pagination__ellipsis\" aria-hidden=\"true\">…</li>\n<li>\n<button type=\"button\" aria-label=\"Page 10\" class=\"slr-pagination__link\">10</button>\n</li>\n<li>\n<button type=\"button\" aria-label=\"Next\" class=\"slr-pagination__link\">\n<span class=\"slr-pagination__label\">Next</span>\n<span aria-hidden=\"true\">›</span>\n</button>\n</li>\n</ul>\n</nav>\n</section>\n</main>",
